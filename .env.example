# =====================================================================
# 环境变量配置模板
# =====================================================================
# 使用方法：把本文件复制一份重命名为 .env，然后按需修改各项值。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# 注意：
#   1. .env 已被 .gitignore 排除，不会提交到 git，密钥只留在本机
#   2. 下面所有项都有代码内默认值，只填 DASHSCOPE_API_KEY 也能跑通全部 AI 功能
#   3. 换模型/换服务商只改这里的值，不需要动任何代码

# ---------------------------------------------------------------------
# 【必填】阿里云 DashScope API 密钥（出题/报告/语音/表情全靠它）
# 获取地址：https://bailian.console.aliyun.com/ 开通后创建 API-KEY
# 不填则所有 AI 功能自动走降级链：出题用默认题库、朗读用浏览器内置语音
#
# 新版百炼注意（2026 起）：key 绑定业务空间专属域名，创建 key 后详情页会给出
# openAiCompatible 和 dashScope 两个地址，需配套填到下面的 BASE_URL / NATIVE_URL，
# 缺了任何一个都会报 401 invalid_api_key（老网关不认新版工作空间 key）
# ---------------------------------------------------------------------
DASHSCOPE_API_KEY=

# ---------------------------------------------------------------------
# 文本模型配置（出题 + 面试报告，走 OpenAI 兼容端点）
# ---------------------------------------------------------------------
# DashScope OpenAI 兼容接口地址（出题/报告走这里）
# 新版百炼：填控制台 key 详情页的 openAiCompatible 地址（ws-xxx...maas.aliyuncs.com/compatible-mode/v1）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 文本模型名，出题和报告统一使用。
# 百炼常用模型价格（元/百万 token，输入/输出，2026-10 查询）：
#   qwen-flash  0.15 / 1.5   ← 最便宜的合理选择（默认）
#   qwen-turbo  0.3 / 0.6
#   qwen-plus   0.8 / 2
#   qwen-max    2.4 / 9.6
LLM_MODEL=qwen-flash

# ---------------------------------------------------------------------
# 语音 / 视觉模型配置（走 DashScope 原生端点，与上面的兼容端点不是同一个地址）
# ---------------------------------------------------------------------
# DashScope 原生 API 端点（语音/表情走这里，代码自动拼 /api/v1/... 路径）
# 新版百炼：填控制台 key 详情页的 dashScope 地址的域名部分（不带 /api/v1 后缀）
DASHSCOPE_NATIVE_URL=https://dashscope.aliyuncs.com

# 语音识别模型（ASR：把面试录音转成文字）
ASR_MODEL=paraformer-v2

# 语音合成模型（TTS：把面试题朗读出来）
TTS_MODEL=Qwen-TTS

# 视觉理解模型（表情识别：分析摄像头抓拍画面里的情绪，走 OpenAI 兼容端点）
VISION_MODEL=qwen3-vl-flash

# 默认朗读音色（前端传来的音色类型不在映射表里时兜底用）
DEFAULT_TTS_VOICE=zh-CN-YunxiNeural

# ---------------------------------------------------------------------
# 备用配置（当前代码未使用，保留供扩展）
# ---------------------------------------------------------------------
# OpenAI API 密钥（备用）
OPENAI_API_KEY=
# OpenAI API 地址（默认使用国内代理）
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1

# ---------------------------------------------------------------------
# 运行配置（一般不用改）
# ---------------------------------------------------------------------
# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=DEBUG
# 临时文件目录（PDF 处理等中间文件，默认 app/temp）
# TEMP_DIR=
